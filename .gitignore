/target
# ★ `vendor/pingora` 是**另一個 workspace**：對它直接跑 cargo（不帶 --target-dir）會在
#   `vendor/pingora/target/` 下堆出幾百 MB，而上面那條 `/target` 錨定根目錄、蓋不住它。
#   所以再加一條不錨定的，任何層級的 target/ 都蓋住。
target/
**/*.rs.bk

# 執行期產物（處理程序、套接字、紀錄），不入庫
/run/
*.pid
*.sock

# Python 工具的位元組碼。★ 直接跑指令碼不會產生它，但**任何 import 都會**。
__pycache__/
*.py[cod]

# 工作過程記錄（交接、草稿）只留在本機，不入庫（G115）
/handoff/

# 對拍的輸出目錄（`bench/run.sh` 的預設落點）。
# ⚠ ⚠ 擋在這裡的只是**預設落點**，⛔ 不是「對拍的原始資料不入庫」——
#   G19 要求基準指令碼與**原始資料**全部公開。真要發佈的那一趟應當寫到一個
#   指定目錄再單獨提交，⛔ 別把這條 ignore 讀成一條資料保密規定。
/bench/out/

# Local operating state; keep public benchmark inputs and vendor TLS fixtures.
/.local/
/.scratch/
/vardata/
/credentials/
/.env
/.env.*
!/.env.example
/*.bundle
.DS_Store
Thumbs.db
