[Unit]
Description=Fulcrum M1 spike —— systemd 下的零停机升级

[Service]
# G31 的形狀：前台 + notify。沒有 PIDFile=（那是給 systemd 跟蹤用的，這裡不需要）。
Type=notify

# ★ ★ ★ **這一行才是讓 unit 活過升級的東西，不是 MainPID 交接。**
#
#   G31 拍板時的推斷是「新處理程序必須落在同一個 cgroup 內**並搶過 MainPID**」。
#   前半句對，後半句實測**是錯的，而且有害**：
#
#   | 口徑 | 老代退出後 unit | systemctl stop |
#   |---|---|---|
#   | 交接 MainPID（G31 推斷的形狀）| active | ★ 0 秒 SIGKILL，failed(signal) |
#   | **ExitType=cgroup，不交接** | active | ★ 10 秒走完排空，success |
#   | 兩者都用 | active | ★ 0 秒 SIGKILL，failed(signal) |
#
#   原因：交接過去的 pid 不是 systemd 親生的（它是老處理程序 fork 的），systemd 會打
#   "Supervising process N which is not our child" 並把它標成 alien，此後停機不再等它排空。
#   `ExitType=cgroup`（systemd ≥ 250）換了個判據——**cgroup 裡還有處理程序就算活著**，
#   於是既不需要交接，停機也照常等排空。
#
#   ⚠ 代價：第一次升級之後 `MainPID` 變成 0（見下面 ExecReload）。
ExitType=cgroup

NotifyAccess=main

ExecStart=/w/target/release/m1-systemd -c /w/conf/m1.yaml

# ★ **不能寫成 `/bin/kill -USR2 $MAINPID`。** `ExitType=cgroup` 下第一次升級之後
#   `$MAINPID` 就是空的，那行會展開成 `kill -USR2`。**實測**（不是推的）：
#   第一次 reload 正常，第二次 `systemctl reload` 結束代碼 **1**，journal 裡是 `kill` 的 Usage
#   與 `Reload failed`，而 unit 仍是 `active/success` —— ★ **回報錯誤了，但升級沒發生**，
#   服務照常跑著老一代。⚠ 本註解初稿寫的是「靜默地什麼都不做」，實測推翻了「靜默」二字。
#   改從 pid 檔案找當前這一代——它由每一代在**自己真的起來之後**原子寫入。
ExecReload=/bin/sh -c 'kill -USR2 "$(cat /run/fulcrum-m1/fulcrum.pid)"'

# G33：runtime 目錄交給 systemd 建（upgrade sock 與 pid 檔案都放這裡）。
RuntimeDirectory=fulcrum-m1
RuntimeDirectoryPreserve=yes

KillMode=control-group

# ★ 這個數不是拍腦袋：= grace_period_seconds + graceful_shutdown_timeout_seconds + 餘量。
#   conf/m1.yaml 是 5 + 5，實測停機正好 10 秒，所以 10 是下限，給到 60。
#   ⚠ 產品預設設定（M0 用的 30 + 30）對應的量級是 35–65 秒 —— 見 tests/m0/lifecycle.sh 裡
#     實測出的那張表：**一旦某一代開始排空，它就收不到任何可捕獲的信號了**，
#     `systemctl stop` 之後再補一刀是沒用的，只能等它自己走完。
TimeoutStopSec=60

# ★ 本 spike 顯式關掉自動重新啟動。理由是判據：反證場景要看的正是「unit 死了」，
#   自動拉起會把它變成「unit 活著」，判據當場失效。
Restart=no

Environment=RUST_LOG=info

[Install]
WantedBy=multi-user.target
