[Unit]
Description=Fulcrum（产品二进制）—— systemd 托管与零停机换代

# ★ ★ ★ 這個 unit 與 `fulcrum-m1.service` 的關係是本批的**全部要點**。
#
#   那一份跑的是 spike（`target/release/m1-systemd`），而 spike 把
#   sd_notify / pid 檔案 / SIGUSR2 換代**自己實作了一遍**。
#   於是 M1 的三個場景全綠，而**產品二進位 `systemctl start` 會超時失敗**
#   （2026-08-20 實測：MainPID=0、Result=timeout、/run/fulcrum/ 是空的）。
#
#   > ★ 一個 spike 證明的是「這條路走得通」，不是「產品走在這條路上」。
#     夾具餵給門的那個二進位，本身也是夾具的一部分。
#
#   這一份**只跑產品二進位**，形狀與 fulcrum-m1.service 逐項相同（有意的：
#   兩份如果長得不一樣，紅了之後分不清是產品的問題還是 unit 寫法的問題）。

[Service]
# G31 的形狀：前台 + notify。沒有 PIDFile=（那是給 systemd 跟蹤用的，這裡不需要）。
Type=notify

# ★ 讓 unit 活過換代的是這一行，不是 MainPID 交接（G37 否掉了交接，
#   理由與實測對照表見 fulcrum-m1.service 與 docs/architecture/process-model.md）。
ExitType=cgroup

NotifyAccess=main

# ★ 設定放在 /etc/fulcrum（形狀同 G33 的 `ConfigurationDirectory=`），由場景指令碼寫入。
#   ⚠ 換代是 fork+exec **同一條命令行**，所以下一代會**重新讀一遍這個檔案** ——
#   「改設定 + systemctl reload」這條路的判據就建在這上面（M1 退出條件第 3 條）。
# ★ ★ 有意**不直接指 /w/target/release/fulcrum**：那個檔案在共享的 target 卷裡，
#   而本場景要做一次「把二進位換掉再 reload」（升級的標準做法）。
#   場景指令碼先把它裝到這個容器本機的路徑上，於是換掉它不會影響別的場景。
#   ⚠ 這也更像真實部署：生產裡就是 /usr/local/bin/fulcrum。
ExecStart=/opt/fulcrum/fulcrum serve /etc/fulcrum/Fulcrumfile

# ★ **不能寫成 `/bin/kill -USR2 $MAINPID`**：`ExitType=cgroup` 下第一次換代之後
#   `$MAINPID` 就是空的（實測：第二次 reload 結束代碼 1、journal 裡是 kill 的 Usage，
#   而 unit 仍 active —— 回報錯誤了，但換代沒發生）。改從 pid 檔案找當前這一代。
ExecReload=/bin/sh -c 'kill -USR2 "$(cat /run/fulcrum/fulcrum.pid)"'

# G33：runtime / state 目錄交給 systemd 建。
# ★ RuntimeDirectory 裡放 pid 檔案、升級 socket 與管理面 socket；
#   StateDirectory 裡放證書（本場景不簽證書，但 serve 啟動時會去看那個目錄）。
RuntimeDirectory=fulcrum
RuntimeDirectoryPreserve=yes
StateDirectory=fulcrum

KillMode=control-group

# ★ ★ 這個 60 是**判據的一部分，不是富餘量**。
#   產品預設排空視窗 30s + 收尾 5s ≈ 35s（crates/fulcrum-server/src/process.rs 裡那兩個常數），
#   所以 60 足夠。⚠ 而在批 12 之前，`grace_period_seconds` 沒配就是 `None`，
#   pingora 會用它自己的 `EXIT_TIMEOUT = 300` —— 那時這一行會讓 systemd 在排空
#   進行到 1/5 時 SIGKILL，`systemctl stop` 以 failed(signal) 收場。
#   ⇒ 本場景**有意不在 Fulcrumfile 裡寫 `grace_period`**，就是為了讓預設值走這條路。
TimeoutStopSec=60

# ★ 顯式關掉自動重新啟動：判據要看的是「它自己起沒起來」，
#   自動拉起會把一次失敗的 start 變成「過一會兒就 active 了」。
Restart=no

Environment=RUST_LOG=info

[Install]
WantedBy=multi-user.target
