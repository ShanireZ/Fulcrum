+                        // There are at most `MAX_HEADERS` refs and they are only needed until
+                        // the headers are appended below, so keep them on the stack.
+                        let mut header_ref_slots =
+                            [const { std::mem::MaybeUninit::<KVRef>::uninit() }; MAX_HEADERS];
+                        let header_refs =
+                            populate_header_refs(base, &mut header_ref_slots, req.headers);
 
                         let mut request_header = Box::new(RequestHeader::build(
                             req.method.unwrap_or(""),
