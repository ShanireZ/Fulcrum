+//! Counts the heap allocations `HttpSession::read_request()` makes for a simple request.
+//!
+//! This is its own test binary because `#[global_allocator]` applies to the whole binary.
+//! Only allocations on the counting thread are counted, and the runtime is current-thread, so the
+//! future under test is polled on that thread.
+
+use std::alloc::{GlobalAlloc, Layout, System};
+use std::cell::Cell;
+use std::future::Future;
+
+use pingora_core::protocols::http::v1::server::HttpSession;
+use tokio_test::io::Builder;
+
+struct CountingAllocator;
+
+thread_local! {
+    static COUNTING: Cell<bool> = const { Cell::new(false) };
+    static COUNT: Cell<u64> = const { Cell::new(0) };
+}
+
+fn record_allocation() {
+    // `try_with`: the allocator is still called while thread-locals are being torn down.
+    let _ = COUNTING.try_with(|counting| {
+        if counting.get() {
+            let _ = COUNT.try_with(|count| count.set(count.get() + 1));
+        }
+    });
+}
+
+unsafe impl GlobalAlloc for CountingAllocator {
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        record_allocation();
+        unsafe { System.alloc(layout) }
+    }
+
+    unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {
+        unsafe { System.dealloc(ptr, layout) }
+    }
+
+    unsafe fn realloc(&self, ptr: *mut u8, layout: Layout, new_size: usize) -> *mut u8 {
+        record_allocation();
+        unsafe { System.realloc(ptr, layout, new_size) }
+    }
+}
+
+#[global_allocator]
+static ALLOCATOR: CountingAllocator = CountingAllocator;
+
+/// Counts the allocations made on this thread while `f` is polled.
+async fn count_allocations<T>(f: impl Future<Output = T>) -> (T, u64) {
+    COUNT.with(|count| count.set(0));
+    COUNTING.with(|counting| counting.set(true));
+    let out = f.await;
+    COUNTING.with(|counting| counting.set(false));
+    (out, COUNT.with(|count| count.get()))
+}
+
+fn current_thread_runtime() -> tokio::runtime::Runtime {
+    tokio::runtime::Builder::new_current_thread()
+        .build()
+        .unwrap()
+}
+
+const REQUEST: &[u8] =
+    b"GET /index.html HTTP/1.1\r\nHost: pingora.org\r\nUser-Agent: test\r\nAccept: */*\r\n\r\n";
+
+/// Reads `REQUEST`, which arrives in a single read, and returns how many allocations that took.
+fn read_request_allocations() -> u64 {
+    let runtime = current_thread_runtime();
+    let mock_io = Builder::new().read(REQUEST).build();
+    let mut session = HttpSession::new(Box::new(mock_io));
+    let (res, allocations) = runtime.block_on(count_allocations(session.read_request()));
+    assert_eq!(Some(REQUEST.len()), res.unwrap());
+    assert_eq!(3, session.req_header().headers.len());
+    allocations
+}
+
+#[test]
+fn counting_allocator_counts() {
+    let runtime = current_thread_runtime();
+    let (_, allocations) = runtime.block_on(count_allocations(async {
+        std::hint::black_box(Vec::<u8>::with_capacity(16));
+    }));
+    assert!(allocations >= 1, "the counting allocator saw no allocation");
+}
+
+/// The limit is what `read_request()` needed when this test was added; parsing the header refs
+/// no longer allocates. A change that needs more allocations per request should raise it
+/// explicitly, so that the cost shows up in review.
+#[test]
+fn read_request_allocation_budget() {
+    const MAX_ALLOCATIONS: u64 = 8;
+    // The first call may include one-time, process-wide allocations.
+    let _ = read_request_allocations();
+    let allocations = read_request_allocations();
+    assert!(
+        allocations <= MAX_ALLOCATIONS,
+        "read_request() made {allocations} allocations, more than {MAX_ALLOCATIONS}"
+    );
+}
