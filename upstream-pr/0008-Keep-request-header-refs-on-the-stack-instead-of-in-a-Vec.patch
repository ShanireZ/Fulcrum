From 48b0658d8104d86cec1c088073bb10ec48834b73 Mon Sep 17 00:00:00 2001
From: Shanire <shanire86@gmail.com>
Date: Thu, 8 Oct 2026 20:43:58 +0800
Subject: [PATCH 2/2] Keep request header refs on the stack instead of in a Vec

Once a request header is complete, HttpSession::read_request() records the
offset of each header in a freshly allocated Vec<KVRef>, so that the read
buffer can be frozen into Bytes. That Vec only lives until the headers are
appended to the RequestHeader a few lines later, but it costs one heap
allocation per request.

There are at most MAX_HEADERS refs, so write them into a stack array of
MaybeUninit<KVRef> instead, through populate_header_refs(), which applies the
same rule as populate_headers() (unnamed entries are skipped) and returns the
slots it wrote. populate_headers() stays for the response path in client.rs.

Add unit tests for populate_header_refs(), and an integration test, in its own
binary with a counting global allocator, that bounds the allocations
read_request() makes for a simple request. It fails with this change
reverted.

Signed-off-by: Shanire <shanire86@gmail.com>
---
 pingora-core/src/protocols/http/v1/common.rs  |  74 ++++++++++++
 pingora-core/src/protocols/http/v1/server.rs  |  10 +-
 .../tests/read_request_allocations.rs         | 114 ++++++++++++++++++
 3 files changed, 194 insertions(+), 4 deletions(-)
 create mode 100644 pingora-core/tests/read_request_allocations.rs

diff --git a/pingora-core/src/protocols/http/v1/common.rs b/pingora-core/src/protocols/http/v1/common.rs
index bfd1291..cd78880 100644
--- a/pingora-core/src/protocols/http/v1/common.rs
+++ b/pingora-core/src/protocols/http/v1/common.rs
@@ -18,6 +18,7 @@ use http::{header, HeaderValue};
 use log::{debug, warn};
 use pingora_error::{Error, ErrorType::*, Result};
 use pingora_http::{HMap, RequestHeader, ResponseHeader};
+use std::mem::MaybeUninit;
 use std::str;
 use std::time::Duration;
 
@@ -288,6 +289,35 @@ pub(super) fn populate_headers(
     used_header_index
 }
 
+/// Like [`populate_headers`], but writes the refs into caller-provided slots, which may be
+/// uninitialized, instead of a `Vec`, and returns the slots it wrote.
+///
+/// # Panics
+/// If `headers` has more named entries than there are slots.
+#[inline]
+pub(super) fn populate_header_refs<'a>(
+    base: usize,
+    header_ref: &'a mut [MaybeUninit<KVRef>],
+    headers: &[httparse::Header],
+) -> &'a [KVRef] {
+    let mut used_header_index = 0;
+    for header in headers.iter() {
+        if !header.name.is_empty() {
+            // Indexing panics instead of writing out of bounds.
+            header_ref[used_header_index].write(KVRef::new(
+                header.name.as_ptr() as usize - base,
+                header.name.len(),
+                header.value.as_ptr() as usize - base,
+                header.value.len(),
+            ));
+            used_header_index += 1;
+        }
+    }
+    // SAFETY: the first `used_header_index` slots were initialized above, and
+    // `MaybeUninit<KVRef>` has the same layout as `KVRef`.
+    unsafe { std::slice::from_raw_parts(header_ref.as_ptr().cast(), used_header_index) }
+}
+
 /// Parse a `Content-Length` field value as an ASCII digit string, matching
 /// hyper's `from_digits`
 /// (<https://github.com/hyperium/hyper/blob/v1.9.0/src/headers.rs#L72-L97>).
@@ -651,4 +681,48 @@ mod test {
         }
         assert_eq!(is_chunked_encoding_from_headers(&headers), expected);
     }
+
+    const HEADER_REFS_REQ: &[u8] =
+        b"GET / HTTP/1.1\r\nHost: pingora.org\r\nX-Empty:\r\nAccept: */*\r\n\r\n";
+
+    /// The headers of `HEADER_REFS_REQ`, with an unnamed entry inserted, which is skipped.
+    fn header_refs_input() -> Vec<httparse::Header<'static>> {
+        let mut headers = [httparse::EMPTY_HEADER; 4];
+        let mut req = httparse::Request::new(&mut headers);
+        assert!(req.parse(HEADER_REFS_REQ).unwrap().is_complete());
+        let mut headers = req.headers.to_vec();
+        headers.insert(1, httparse::EMPTY_HEADER);
+        headers
+    }
+
+    #[test]
+    fn test_populate_header_refs() {
+        let buf = HEADER_REFS_REQ;
+        let headers = header_refs_input();
+        let base = buf.as_ptr() as usize;
+
+        let mut expected = Vec::new();
+        assert_eq!(3, populate_headers(base, &mut expected, &headers));
+
+        let mut slots = [const { MaybeUninit::uninit() }; 3];
+        let refs = populate_header_refs(base, &mut slots, &headers);
+        assert_eq!(3, refs.len());
+        for (expected, actual) in expected.iter().zip(refs) {
+            assert_eq!(expected.get_name(buf), actual.get_name(buf));
+            assert_eq!(expected.get_value(buf), actual.get_value(buf));
+        }
+        assert_eq!(b"X-Empty", refs[1].get_name(buf));
+        assert_eq!(b"", refs[1].get_value(buf));
+        assert_eq!(b"Accept", refs[2].get_name(buf));
+        assert_eq!(b"*/*", refs[2].get_value(buf));
+    }
+
+    #[test]
+    #[should_panic(expected = "index out of bounds")]
+    fn test_populate_header_refs_too_few_slots() {
+        let buf = HEADER_REFS_REQ;
+        let headers = header_refs_input();
+        let mut slots = [const { MaybeUninit::uninit() }; 2];
+        populate_header_refs(buf.as_ptr() as usize, &mut slots, &headers);
+    }
 }
