From 892e0b0f386f055fc440d4187b2b69e8340b920a Mon Sep 17 00:00:00 2001
From: Shanire <shanire86@gmail.com>
Date: Fri, 16 Oct 2026 10:59:14 +0900
Subject: [PATCH] Avoid two allocations when writing an HTTP/1 response header

HttpSession::prepare_response_header() makes two heap allocations per
response that are not needed:

- The Connection value is inserted as a &str, which HeaderValue::from_str()
  copies into a new buffer every time. The two values are static, so insert
  them with HeaderValue::from_static() instead, as the "make these lazy
  static" TODO asked.
- The serialized header is returned as frozen Bytes. Freezing a BytesMut
  whose length differs from its capacity (the buffer starts at
  INIT_HEADER_BUF_SIZE) allocates a shared header, but
  write_response_header() only borrows the bytes for write_all() and drops
  them. Return the BytesMut, and freeze it only in the proxy-task path,
  which hands it to send_header_task().

The bytes written do not change.

Add an integration test, in its own binary with a counting global
allocator, that bounds the allocations write_response_header() makes for a
simple response to one (the serialization buffer), and pins the bytes it
writes for keep-alive and close responses. The budget fails with either
change reverted.

Signed-off-by: Shanire <shanire86@gmail.com>
---
 pingora-core/src/protocols/http/v1/server.rs  |  22 ++-
 .../write_response_header_allocations.rs      | 183 ++++++++++++++++++
 2 files changed, 197 insertions(+), 8 deletions(-)
 create mode 100644 pingora-core/tests/write_response_header_allocations.rs

diff --git a/pingora-core/src/protocols/http/v1/server.rs b/pingora-core/src/protocols/http/v1/server.rs
index 71c7a2a..35be693 100644
--- a/pingora-core/src/protocols/http/v1/server.rs
+++ b/pingora-core/src/protocols/http/v1/server.rs
@@ -817,10 +817,14 @@ impl HttpSession {
     /// Prepare response header for writing: handle upgrades, set headers, initialize body writer.
     /// This contains all the synchronous logic that should happen before writing the header.
     /// Returns Ok(Some((bytes, should_flush))) if the header should be written, Ok(None) if should skip.
+    ///
+    /// The bytes are returned unfrozen: the direct write path only borrows them, and freezing a
+    /// buffer whose length differs from its capacity allocates a shared header. Callers that need
+    /// `Bytes` freeze them.
     fn prepare_response_header(
         &mut self,
         header: &mut ResponseHeader,
-    ) -> Result<Option<(Bytes, bool)>> {
+    ) -> Result<Option<(BytesMut, bool)>> {
         // Check if we should ignore informational responses
         if header.status.is_informational() && self.ignore_info_resp(header.status.into()) {
             debug!("ignoring informational headers");
@@ -848,11 +852,11 @@ impl HttpSession {
             /* update headers */
             header.insert_header(header::DATE, date::get_cached_date())?;
 
-            // TODO: make these lazy static
+            // Static values: a `&str` would be copied into a new `HeaderValue` on every response.
             let connection_value = if self.will_keepalive() {
-                "keep-alive"
+                HeaderValue::from_static("keep-alive")
             } else {
-                "close"
+                HeaderValue::from_static("close")
             };
             header.insert_header(header::CONNECTION, connection_value)?;
         }
@@ -922,7 +926,7 @@ impl HttpSession {
         let should_flush = header.status.is_informational()
             || header.headers.get(header::CONTENT_LENGTH).is_none();
 
-        Ok(Some((write_buf.freeze(), should_flush)))
+        Ok(Some((write_buf, should_flush)))
     }
 
     fn init_body_writer(&mut self, header: &ResponseHeader) {
@@ -1693,9 +1697,11 @@ impl HttpSession {
                     };
                     // header only responses will want to flush
                     let flush = should_flush || self.body_writer.finished();
-                    self.proxy_task_state
-                        .header_writer()
-                        .send_header_task(write_buf, flush, None);
+                    self.proxy_task_state.header_writer().send_header_task(
+                        write_buf.freeze(),
+                        flush,
+                        None,
+                    );
                     self.proxy_task_state.current_writer =
                         Some(ProxyTaskWriter::WritingHeader(header, end));
                 }
diff --git a/pingora-core/tests/write_response_header_allocations.rs b/pingora-core/tests/write_response_header_allocations.rs
new file mode 100644
index 0000000..a554808
--- /dev/null
+++ b/pingora-core/tests/write_response_header_allocations.rs
@@ -0,0 +1,183 @@
