+
+//! Counts the heap allocations `HttpSession::write_response_header()` makes for a simple
+//! response, and checks the bytes it writes.
+//!
+//! This is its own test binary because `#[global_allocator]` applies to the whole binary.
+//! Only allocations on the counting thread are counted, and the runtime is current-thread, so the
+//! future under test is polled on that thread.
+
+use std::alloc::{GlobalAlloc, Layout, System};
+use std::cell::Cell;
+use std::future::Future;
+use std::io::Cursor;
+
+use http::HeaderValue;
+use pingora_core::protocols::http::v1::server::HttpSession;
+use pingora_http::ResponseHeader;
+
+struct CountingAllocator;
+
+thread_local! {
+    static COUNTING: Cell<bool> = const { Cell::new(false) };
+    static COUNT: Cell<u64> = const { Cell::new(0) };
+}
+
+fn record_allocation() {
+    // `try_with`: the allocator is still called while thread-locals are being torn down.
+    let _ = COUNTING.try_with(|counting| {
+        if counting.get() {
+            let _ = COUNT.try_with(|count| count.set(count.get() + 1));
+        }
+    });
+}
+
+unsafe impl GlobalAlloc for CountingAllocator {
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        record_allocation();
+        unsafe { System.alloc(layout) }
+    }
+
+    unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {
+        unsafe { System.dealloc(ptr, layout) }
+    }
+
+    unsafe fn realloc(&self, ptr: *mut u8, layout: Layout, new_size: usize) -> *mut u8 {
+        record_allocation();
+        unsafe { System.realloc(ptr, layout, new_size) }
+    }
+}
+
+#[global_allocator]
+static ALLOCATOR: CountingAllocator = CountingAllocator;
+
+/// Counts the allocations made on this thread while `f` is polled.
+async fn count_allocations<T>(f: impl Future<Output = T>) -> (T, u64) {
+    COUNT.with(|count| count.set(0));
+    COUNTING.with(|counting| counting.set(true));
+    let out = f.await;
+    COUNTING.with(|counting| counting.set(false));
+    (out, COUNT.with(|count| count.get()))
+}
+
+fn current_thread_runtime() -> tokio::runtime::Runtime {
+    tokio::runtime::Builder::new_current_thread()
+        .build()
+        .unwrap()
+}
+
+/// Answered with `Connection: keep-alive`.
+const KEEPALIVE_REQUEST: &[u8] = b"GET / HTTP/1.1\r\nHost: pingora.org\r\n\r\n";
+/// Answered with `Connection: close`.
+const CLOSE_REQUEST: &[u8] = b"GET / HTTP/1.1\r\nHost: pingora.org\r\nConnection: close\r\n\r\n";
+
+/// A session over an in-memory stream: the request bytes first, the written bytes appended after
+/// them. The capacity is reserved up front, so writing does not allocate in the stream itself.
+fn session_over_cursor(request: &[u8]) -> HttpSession {
+    let mut wire = Vec::with_capacity(64 * 1024);
+    wire.extend_from_slice(request);
+    HttpSession::new(Box::new(Cursor::new(wire)))
+}
+
+/// The bytes written after the request.
+fn written(session: &HttpSession, request_len: usize) -> Vec<u8> {
+    let wire = (**session.stream())
+        .as_any()
+        .downcast_ref::<Cursor<Vec<u8>>>()
+        .expect("the stream is the Cursor<Vec<u8>> it was created with");
+    wire.get_ref()[request_len..].to_vec()
+}
+
+fn empty_ok_response() -> Box<ResponseHeader> {
+    let mut resp = ResponseHeader::build_no_case(200, Some(4)).unwrap();
+    resp.insert_header(http::header::CONTENT_LENGTH, HeaderValue::from_static("0"))
+        .unwrap();
+    Box::new(resp)
+}
+
+/// Reads `request`, then returns how many allocations writing the response header took. The
+/// response header itself is built before counting starts.
+fn write_response_header_allocations(request: &[u8]) -> u64 {
+    let runtime = current_thread_runtime();
+    let mut session = session_over_cursor(request);
+    runtime.block_on(session.read_request()).unwrap();
+    let resp = empty_ok_response();
+    let (res, allocations) =
+        runtime.block_on(count_allocations(session.write_response_header(resp)));
+    res.unwrap();
+    allocations
+}
+
+#[test]
+fn counting_allocator_counts() {
+    let runtime = current_thread_runtime();
+    let (_, allocations) = runtime.block_on(count_allocations(async {
+        std::hint::black_box(Vec::<u8>::with_capacity(16));
+    }));
+    assert!(allocations >= 1, "the counting allocator saw no allocation");
+}
+
+/// The limit is what `write_response_header()` needed when this test was added: the buffer the
+/// header is serialized into. A change that needs more allocations per response should raise it
+/// explicitly, so that the cost shows up in review.
+///
+/// The cached `Date` value is refreshed once a second, and the first response after a refresh
+/// allocates a few more times; so this takes the fewest of three consecutive writes.
+#[test]
+fn write_response_header_allocation_budget() {
+    const MAX_ALLOCATIONS: u64 = 1;
+    for (request, connection) in [(KEEPALIVE_REQUEST, "keep-alive"), (CLOSE_REQUEST, "close")] {
+        // The first call may include one-time, process-wide allocations.
+        let _ = write_response_header_allocations(request);
+        let allocations = (0..3)
+            .map(|_| write_response_header_allocations(request))
+            .min()
+            .unwrap();
+        assert!(
+            allocations <= MAX_ALLOCATIONS,
+            "writing a `Connection: {connection}` response header made {allocations} allocations, \
+             more than {MAX_ALLOCATIONS}"
+        );
+    }
+}
+
+/// Existing tests of `write_response_header()` mostly turn `update_resp_headers` off, so the
+/// `Date` and `Connection` lines it adds are pinned here, byte for byte except the date itself.
+#[test]
+fn write_response_header_wire_bytes() {
+    let runtime = current_thread_runtime();
+    for (request, connection) in [(KEEPALIVE_REQUEST, "keep-alive"), (CLOSE_REQUEST, "close")] {
+        let mut session = session_over_cursor(request);
+        runtime.block_on(session.read_request()).unwrap();
+        runtime
+            .block_on(session.write_response_header(empty_ok_response()))
+            .unwrap();
+        let out = String::from_utf8(written(&session, request.len())).unwrap();
+        let date = out
+            .split("\r\n")
+            .find_map(|line| line.strip_prefix("Date: "))
+            .unwrap_or_else(|| panic!("no `Date: ` line in {out:?}"));
+        assert!(
+            httpdate::parse_http_date(date).is_ok(),
+            "not an HTTP date: {date:?}"
+        );
+        assert_eq!(
+            format!(
+                "HTTP/1.1 200 OK\r\nContent-Length: 0\r\nDate: {date}\r\nConnection: {connection}\r\n\r\n"
+            ),
+            out
+        );
+    }
+}
