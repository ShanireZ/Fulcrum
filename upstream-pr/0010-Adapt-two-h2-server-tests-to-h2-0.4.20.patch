From 507ef741268f72b8e9f848adbaa5de5c9d70fda2 Mon Sep 17 00:00:00 2001
From: Shanire <shanire86@gmail.com>
Date: Fri, 16 Oct 2026 16:17:14 +0900
Subject: [PATCH] Adapt two h2 server tests to h2 0.4.20 rejecting conflicting
 Content-Length

h2 0.4.20 ("Fix rejecting duplicate content-length headers with different
values") resets a request stream whose Content-Length values conflict with
PROTOCOL_ERROR inside the codec, before accept() returns the request. Two
tests drive exactly such a request into Pingora's acceptance checks, and
they fail on main once a fresh lock resolves h2 0.4.20:

- test_req_conflicting_content_length_rejected expected
  Some(H2Accept::Rejected). The stream no longer reaches Pingora, so
  from_h2_conn() returns None once the client closes the connection. The
  client still sees PROTOCOL_ERROR.
- test_req_malformed_stream_budget_exhausted used the request to exhaust
  MAX_MALFORMED_STREAMS_PER_CONN. It is no longer charged to that budget
  (h2 counts it against its own local error-reset limit), so the test is
  renamed to test_req_conflicting_content_length_not_charged_to_malformed_budget
  and asserts that the budget is untouched. Exhausting the budget stays
  covered by the authority-mismatch and forbidden-target tests.

Raise the workspace h2 requirement to >=0.4.20, since both tests now depend
on that behavior; with h2 0.4.19 they fail.

Signed-off-by: Shanire <shanire86@gmail.com>
---
 Cargo.toml                                   |  2 +-
 pingora-core/src/protocols/http/v2/server.rs | 65 +++++++++++---------
 2 files changed, 36 insertions(+), 31 deletions(-)

diff --git a/Cargo.toml b/Cargo.toml
index 37b3843..57d310a 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -43,7 +43,7 @@ derivative = "2.2.0"
 http = "1"
 log = "0.4"
 futures = "0.3"
-h2 = ">=0.4.16"
+h2 = ">=0.4.20"
 once_cell = "1"
 lru = "0.18.2"
 ahash = ">=0.8.9"
diff --git a/pingora-core/src/protocols/http/v2/server.rs b/pingora-core/src/protocols/http/v2/server.rs
index 6c14b58..d8a3e31 100644
--- a/pingora-core/src/protocols/http/v2/server.rs
+++ b/pingora-core/src/protocols/http/v2/server.rs
@@ -1815,6 +1815,10 @@ mod test {
         }
     }
 
+    // Since h2 0.4.20 the codec itself resets a stream whose duplicate
+    // Content-Length values conflict (PROTOCOL_ERROR), so the request never
+    // reaches `accept()` and Pingora's own duplicate-CL check is not what
+    // rejects it.
     #[tokio::test]
     async fn test_req_conflicting_content_length_rejected() {
         let (client, server) = duplex(65536);
@@ -1836,9 +1840,8 @@ mod test {
                 .unwrap();
 
             let (response, mut req_body) = h2.send_request(request, false).unwrap();
-            // Send a body matching the first Content-Length value so the h2
-            // codec accepts the stream and Pingora's duplicate-CL validation is
-            // what rejects the request.
+            // Send a body matching the first Content-Length value, so the only
+            // thing wrong with the stream is the conflicting header.
             req_body.reserve_capacity(5);
             req_body.send_data("abcde".into(), true).unwrap();
 
@@ -1852,30 +1855,30 @@ mod test {
         let mut connection = handshake(Box::new(server), None).await.unwrap();
         let digest = Arc::new(Digest::default());
 
-        // The malformed stream is reset during acceptance, so it is reported as
-        // rejected rather than surfaced to the application as a session.
-        let accepted = HttpSession::from_h2_conn(&mut connection, digest.clone())
-            .await
-            .unwrap();
-        assert!(
-            matches!(accepted, Some(H2Accept::Rejected)),
-            "malformed request must not surface as a session"
-        );
-
-        let done = timeout(
+        // The codec resets the malformed stream before acceptance, so the first
+        // thing Pingora sees is the connection closing once the client hangs up.
+        let accepted = timeout(
             Duration::from_secs(1),
             HttpSession::from_h2_conn(&mut connection, digest),
         )
         .await
-        .expect("from_h2_conn hung after rejecting malformed request")
-        .expect("from_h2_conn returned an error after rejecting malformed request");
-        assert!(done.is_none(), "connection should close after rejection");
+        .expect("from_h2_conn hung after the codec rejected the malformed request")
+        .expect("from_h2_conn returned an error after the codec rejected the malformed request");
+        assert!(
+            accepted.is_none(),
+            "malformed request must not reach Pingora's acceptance checks"
+        );
 
         client_task.await.unwrap();
     }
 
+    // Since h2 0.4.20 the codec resets this stream itself and charges h2's own
+    // local error-reset limit instead, so Pingora's malformed-stream budget is
+    // left untouched. Exhaustion of that budget is covered by
+    // `test_authority_mismatch_exhausts_malformed_stream_budget` and
+    // `test_forbidden_target_exhausts_malformed_stream_budget`.
     #[tokio::test]
-    async fn test_req_malformed_stream_budget_exhausted() {
+    async fn test_req_conflicting_content_length_not_charged_to_malformed_budget() {
         let (client, server) = duplex(65536);
 
         let client_task = tokio::spawn(async move {
@@ -1906,20 +1909,22 @@ mod test {
         let digest = Arc::new(Digest::default());
         let mut malformed_streams = MAX_MALFORMED_STREAMS_PER_CONN - 1;
 
-        let err = match HttpSession::from_h2_conn_with_malformed_budget(
-            &mut connection,
-            digest,
-            &mut malformed_streams,
+        let accepted = timeout(
+            Duration::from_secs(1),
+            HttpSession::from_h2_conn_with_malformed_budget(
+                &mut connection,
+                digest,
+                &mut malformed_streams,
+            ),
         )
         .await
-        {
-            Ok(Some(_)) => panic!("malformed request must not surface as a session"),
-            Ok(None) => panic!("connection ended before malformed budget was exhausted"),
-            Err(err) => err,
-        };
-
-        assert_eq!(err.etype(), &ErrorType::H2Error);
-        assert_eq!(malformed_streams, MAX_MALFORMED_STREAMS_PER_CONN);
+        .expect("from_h2_conn hung after the codec rejected the malformed request");
+        match accepted {
+            Ok(None) => {}
+            Ok(Some(_)) => panic!("malformed request must not reach Pingora's acceptance checks"),
+            Err(err) => panic!("malformed request was charged to Pingora's budget: {err}"),
+        }
+        assert_eq!(malformed_streams, MAX_MALFORMED_STREAMS_PER_CONN - 1);
 
         drop(connection);
         client_task.await.unwrap();
-- 
